<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IcreamShopCilent</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IcreamShopCilent.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Inject IHttpContextAccessor để truy cập HttpContext -->
    @inject IHttpContextAccessor HttpContextAccessor

    <header>
        <nav class="navbar navbar-expand-sm navbar-light ice-cream-nav">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    IcreamShopCilent 🍦
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/User/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/User/Cart">Giỏ hàng</a>
                        </li>
                        
                        <a class="nav-link" href="/User/Order">Lịch sử đơn hàng</a>
                      
                        <!-- Kiểm tra trạng thái đăng nhập -->
                        @if (HttpContextAccessor.HttpContext?.Session.GetString("JWToken") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link">Hello, @HttpContextAccessor.HttpContext?.Session.GetString("Email")!</span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Auth/Login" asp-page-handler="Logout" style="display:inline;">
                                    <button type="submit" class="nav-link btn btn-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Auth/Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            © 2025 - IcreamShopCilent - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>