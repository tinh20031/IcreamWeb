<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IceCreamShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IcreamShopCilent.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    @inject IHttpContextAccessor HttpContextAccessor

    <header>
        <nav class="navbar navbar-expand-sm navbar-light ice-cream-nav">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/User/Index">IceCreamShop 🍦</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/User/Index">Trang chủ</a>
                        </li>

                        @if (!string.IsNullOrEmpty(HttpContextAccessor.HttpContext?.Session.GetString("JWToken")))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/User/Cart">Giỏ Hàng 🛒</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/User/Order">Đơn Hàng 📜</a>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link text-white fw-semibold me-2">Xin chào, @HttpContextAccessor.HttpContext?.Session.GetString("FullName")!</span>
                                <div class="dropdown">
                                    <a class="nav-link dropdown-toggle text-white fw-semibold user-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle me-1"></i>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3" aria-labelledby="userDropdown">
                                        <li><a class="dropdown-item" asp-page="/User/Profile" asp-route-id="@Context.Session.GetInt32("UserId")">Hồ Sơ Cá Nhân 👤</a></li>
                                        <li><a class="dropdown-item" asp-page="/User/ChangePassword">Đổi Mật Khẩu 🔒</a></li>
                                        <li>
                                            <form method="post" asp-page="/Auth/Login" asp-page-handler="Logout">
                                                <button type="submit" class="dropdown-item">Đăng Xuất 🚪</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Auth/Login">Đăng Nhập 🔑</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            © 2025 - IceCreamShop - <a asp-area="" asp-page="/Privacy">Quyền riêng tư</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>