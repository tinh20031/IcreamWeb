@page
@model IcreamShopCilent.Pages.User.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    body {
        background-color: #f5f8fa;
    }

    .change-password-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 75vh;
        padding: 40px 15px;
    }

    .change-password-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        padding: 40px;
        max-width: 600px;
        width: 100%;
    }

        .change-password-card h2 {
            font-size: 28px;
            font-weight: 700;
            text-align: center;
            color: #333;
            margin-bottom: 30px;
        }

        .change-password-card label {
            font-weight: 600;
            color: #444;
        }

        .change-password-card input {
            border-radius: 10px;
            height: 45px;
            font-size: 16px;
        }

        .change-password-card .btn-primary {
            background: linear-gradient(to right, #0d6efd, #0aa2c0);
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 16px;
            padding: 10px 0;
            width: 100%;
            margin-top: 10px;
            transition: 0.3s;
        }

            .change-password-card .btn-primary:hover {
                background: linear-gradient(to right, #0aa2c0, #0d6efd);
            }

    .alert {
        margin-bottom: 20px;
        text-align: center;
    }
</style>

<div class="change-password-wrapper">
    <div class="change-password-card">
        <h2>Đổi mật khẩu</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Mật khẩu hiện tại</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>
