        async function placeOrder() {
            console.log("UserId in placeOrder:", userId);
            console.log("Token in placeOrder:", token);
            if (!userId || userId === 0 || !token) {
                alert("Vui lòng đăng nhập để thực hiện thao tác này!");
                window.location.href = "/Auth/Login";
                return;
            }

            const shippingAddressInput = document.getElementById("shippingAddress").value.trim();
            if (!shippingAddressInput) {
                alert("Vui lòng nhập địa chỉ giao hàng!");
                return;
            }

            if (!confirm("Bạn có chắc muốn thanh toán qua VNPAY?")) return;

            try {
                const requestBody = {
                    shippingAddress: shippingAddressInput
                };

                console.log("Gửi yêu cầu tạo thanh toán:", requestBody);

                const response = await fetch(`https://localhost:7283/api/CartApi/create-payment/${userId}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify(requestBody)
                });

                const contentType = response.headers.get('content-type');
                const responseText = await response.text();
                console.log("Phản hồi từ API CartApi:", responseText);

                if (!response.ok) {
                    if (response.status === 401) {
                        alert("Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại!");
                        window.location.href = "/Auth/Login";
                        return;
                    }

                    if (contentType && contentType.includes('application/json')) {
                        const error = JSON.parse(responseText);
                        throw new Error(error.message || 'Không thể tạo yêu cầu thanh toán.');
                    } else {
                        throw new Error(responseText || 'Không thể tạo yêu cầu thanh toán.');
                    }
                }

                if (!contentType || !contentType.includes('application/json')) {
                    throw new Error(`Phản hồi không phải JSON: ${responseText || 'Không có nội dung'}`);
                }

                const paymentData = JSON.parse(responseText);
                if (paymentData.orderUrl) {
                    // Chuyển hướng đến trang thanh toán VNPAY
                    window.location.href = paymentData.orderUrl;
                } else {
                    throw new Error("Không nhận được URL thanh toán từ VNPAY.");
                }
            } catch (error) {
                console.error("Lỗi khi tạo thanh toán:", error);
                alert("Đã xảy ra lỗi khi tạo thanh toán: " + error.message);
            }
        }
    </script>
