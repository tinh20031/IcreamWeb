@page
@model IcreamShopCilent.Pages.User.CheckoutModel
@{
    ViewData["Title"] = "Thanh toán";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .checkout-container {
            padding: 20px;
            background: linear-gradient(135deg, #fff3e0, #ffe6f2, #e6f7ff);
            min-height: 100vh;
        }

        .checkout-table {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

            .checkout-table th, .checkout-table td {
                vertical-align: middle;
                text-align: center;
            }

            .checkout-table th {
                background: linear-gradient(45deg, #ff6f91, #ffcc70);
                color: white;
                font-weight: bold;
            }

            .checkout-table img {
                width: 80px;
                height: 80px;
                object-fit: cover;
                border-radius: 10px;
            }

        .address-section {
            background: white;
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        .btn-action {
            background: linear-gradient(45deg, #ff6f91, #ffcc70);
            border: none;
            border-radius: 10px;
            padding: 5px 10px;
            color: white;
            font-weight: bold;
            transition: transform 0.2s;
        }

            .btn-action:hover {
                transform: scale(1.05);
            }

        .icecream-emoji {
            font-size: 1.5em;
            margin: 0 5px;
        }

        .alert {
            border-radius: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }
    </style>
}

<div class="checkout-container">
    <h2 class="text-center mb-4" style="font-family: 'Comic Sans MS', cursive, sans-serif; color: #ff6f91;">Thanh toán đơn hàng <span class="icecream-emoji">📦</span></h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" id="errorAlert">@TempData["Error"]</div>
        <script>
            if ('@TempData["Error"]'.includes("Phiên đăng nhập đã hết hạn")) {
                setTimeout(() => {
                    window.location.href = "/Auth/Login";
                }, 2000); // Chuyển hướng sau 2 giây để người dùng đọc thông báo
            }
        </script>
    }

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="text-center">
            <p style="color: #555;">Giỏ hàng của bạn đang trống! Hãy thêm một vài món kem ngon nhé 🍦</p>
            <a href="/User/Index" class="btn btn-action">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="address-section">
            <h4>Địa chỉ giao hàng</h4>
            <div class="form-group">
                <label>Nhập địa chỉ giao hàng:</label>
                <div class="form-group">
                    <label for="provinceSelect">Tỉnh/Thành phố:</label>
                    <select id="provinceSelect" class="form-control" onchange="loadDistricts()">
                        <option value="">-- Chọn tỉnh/thành phố --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="districtSelect">Quận/Huyện:</label>
                    <select id="districtSelect" class="form-control" onchange="loadWards()" disabled>
                        <option value="">-- Chọn quận/huyện --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="wardSelect">Phường/Xã:</label>
                    <select id="wardSelect" class="form-control" disabled>
                        <option value="">-- Chọn phường/xã --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="streetInput">Số nhà, tên đường:</label>
                    <input type="text" id="streetInput" class="form-control" placeholder="Nhập số nhà, tên đường" />
                </div>
                <div class="form-group">
                    <label for="shippingAddress">Địa chỉ đầy đủ:</label>
                    <textarea id="shippingAddress" class="form-control" rows="3" readonly></textarea>
                </div>
            </div>
        </div>

        <table class="table checkout-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên kem</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Tổng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td><img src="@item.Image" alt="@item.IceCreamName" onerror="this.src='https://example.com/default.jpg'" /></td>
                        <td>@item.IceCreamName</td>
                        <td>$@item.Price.ToString("F2")</td>
                        <td>@item.Quantity</td>
                        <td>$@((item.Price * item.Quantity).ToString("F2"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="cart-summary">
            <h4>Tổng cộng: <span>$@Model.CartItems.Sum(item => item.Price * item.Quantity).ToString("F2")</span></h4>
            <button class="btn btn-action" onclick="placeOrder()">Đặt hàng <span class="icecream-emoji">📦</span></button>
        </div>
    }
</div>

@section Scripts {
    <script>
        const userId = @Model.CurrentUserId;
        const token = '@HttpContext.Session.GetString("JWToken")';
        console.log("Token in Checkout:", token);
        console.log("UserId in Checkout:", userId);

        // Load danh sách tỉnh khi trang được tải
        window.onload = function () {
            loadProvinces();
        };

        // Lấy danh sách tỉnh
        async function loadProvinces() {
            try {
                const response = await fetch('https://provinces.open-api.vn/api/p/');
                const provinces = await response.json();
                const provinceSelect = document.getElementById('provinceSelect');
                provinces.forEach(province => {
                    const option = document.createElement('option');
                    option.value = province.code;
                    option.textContent = province.name;
                    provinceSelect.appendChild(option);
                });
            } catch (error) {
                console.error('Lỗi khi lấy danh sách tỉnh:', error);
                alert('Không thể tải danh sách tỉnh. Vui lòng thử lại sau.');
            }
        }

        // Lấy danh sách quận/huyện khi chọn tỉnh
        async function loadDistricts() {
            const provinceCode = document.getElementById('provinceSelect').value;
            const districtSelect = document.getElementById('districtSelect');
            const wardSelect = document.getElementById('wardSelect');

            // Reset quận/huyện và phường/xã
            districtSelect.innerHTML = '<option value="">-- Chọn quận/huyện --</option>';
            wardSelect.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
            wardSelect.disabled = true;
            districtSelect.disabled = true;

            if (!provinceCode) {
                updateShippingAddress();
                return;
            }

            try {
                const response = await fetch(`https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`);
                const provinceData = await response.json();
                const districts = provinceData.districts;

                districts.forEach(district => {
                    const option = document.createElement('option');
                    option.value = district.code;
                    option.textContent = district.name;
                    districtSelect.appendChild(option);
                });

                districtSelect.disabled = false;
                updateShippingAddress();
            } catch (error) {
                console.error('Lỗi khi lấy danh sách quận/huyện:', error);
                alert('Không thể tải danh sách quận/huyện. Vui lòng thử lại sau.');
            }
        }

        // Lấy danh sách phường/xã khi chọn quận/huyện
        async function loadWards() {
            const districtCode = document.getElementById('districtSelect').value;
            const wardSelect = document.getElementById('wardSelect');

            // Reset phường/xã
            wardSelect.innerHTML = '<option value="">-- Chọn phường/xã --</option>';
            wardSelect.disabled = true;

            if (!districtCode) {
                updateShippingAddress();
                return;
            }

            try {
                const response = await fetch(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`);
                const districtData = await response.json();
                const wards = districtData.wards;

                wards.forEach(ward => {
                    const option = document.createElement('option');
                    option.value = ward.code;
                    option.textContent = ward.name;
                    wardSelect.appendChild(option);
                });

                wardSelect.disabled = false;
                updateShippingAddress();
            } catch (error) {
                console.error('Lỗi khi lấy danh sách phường/xã:', error);
                alert('Không thể tải danh sách phường/xã. Vui lòng thử lại sau.');
            }
        }

        // Cập nhật địa chỉ đầy đủ vào textarea
        function updateShippingAddress() {
            const provinceSelect = document.getElementById('provinceSelect');
            const districtSelect = document.getElementById('districtSelect');
            const wardSelect = document.getElementById('wardSelect');
            const streetInput = document.getElementById('streetInput');
            const shippingAddress = document.getElementById('shippingAddress');

            const province = provinceSelect.options[provinceSelect.selectedIndex]?.text || '';
            const district = districtSelect.options[districtSelect.selectedIndex]?.text || '';
            const ward = wardSelect.options[wardSelect.selectedIndex]?.text || '';
            const street = streetInput.value.trim();

            const fullAddress = [street, ward, district, province].filter(part => part).join(', ');
            shippingAddress.value = fullAddress;
        }

        // Gọi updateShippingAddress khi có thay đổi
        document.getElementById('provinceSelect').addEventListener('change', updateShippingAddress);
        document.getElementById('districtSelect').addEventListener('change', updateShippingAddress);
        document.getElementById('wardSelect').addEventListener('change', updateShippingAddress);
        document.getElementById('streetInput').addEventListener('input', updateShippingAddress);

