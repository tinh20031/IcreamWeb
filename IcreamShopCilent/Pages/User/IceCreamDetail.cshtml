@page "{iceCreamId:int}"
@model IcreamShopCilent.Pages.User.IceCreamDetailModel
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .detail-container {
            padding: 40px;
            background: linear-gradient(135deg, #fff3e0, #ffe6f2, #e6f7ff);
            min-height: 100vh;
        }

        .icecream-detail {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            padding: 20px;
        }

        .icecream-image {
            max-height: 400px;
            object-fit: cover;
            border-radius: 15px;
        }

        .icecream-title {
            font-family: 'Comic Sans MS', cursive, sans-serif;
            color: #ff6f91;
            font-size: 2rem;
        }

        .icecream-price {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ff6f91;
        }

        .icecream-description {
            color: #555;
            font-size: 1.1rem;
        }

        .btn-checkout, .btn-add-cart {
            background: linear-gradient(45deg, #ff6f91, #ffcc70);
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            color: white;
            font-weight: bold;
            transition: transform 0.2s;
            margin-right: 10px;
        }

            .btn-checkout:hover, .btn-add-cart:hover {
                transform: scale(1.05);
            }

        .icecream-emoji {
            font-size: 1.5em;
            margin: 0 5px;
        }

        /* Style cho phần đánh giá */
        .star-rating {
            direction: rtl;
            display: inline-block;
            font-size: 1.5rem;
        }

        .star {
            color: #ccc;
            cursor: pointer;
            transition: color 0.2s;
        }

            .star:hover,
            .star:hover ~ .star,
            .star.selected,
            .star.selected ~ .star {
                color: #ffcc70;
            }

        .review-comment {
            resize: none;
            border: 2px solid #ffd6e8;
            border-radius: 10px;
        }

            .review-comment:focus {
                border-color: #ff6f91;
                outline: none;
            }

        .review-section {
            border-top: 1px solid #eee;
            padding-top: 20px;
            margin-top: 20px;
        }

        .review-list {
            max-height: 300px;
            overflow-y: auto;
            margin-top: 10px;
        }

        .review-item {
            border-bottom: 1px solid #eee;
            padding: 10px 0;
            font-size: 1rem;
        }

        .review-stars {
            color: #ffcc70;
        }

        .review-user {
            font-weight: bold;
            color: #ff6f91;
        }
    </style>
}

<div class="detail-container">
    @if (Model.IceCream != null)
    {
        <div class="icecream-detail">
            <div class="row">
                <div class="col-md-6">
                    <img src="@Model.IceCream.ImageUrl" class="icecream-image" alt="@Model.IceCream.Name">
                </div>
                <div class="col-md-6">
                    <h2 class="icecream-title">@Model.IceCream.Name</h2>
                    <p class="icecream-price">$@Model.IceCream.Price.ToString("F2")</p>
                    <p class="icecream-description">@(Model.IceCream.Description ?? "Không có mô tả.")</p>
                    <div class="mt-4">
                        <button class="btn btn-add-cart" onclick="addToCart(@Model.IceCream.IceCreamId)">Thêm vào giỏ hàng <span class="icecream-emoji">🛒</span></button>
                        <button class="btn btn-checkout" onclick="checkoutIceCream(@Model.IceCream.IceCreamId)">Thanh toán ngay <span class="icecream-emoji">💳</span></button>
                    </div>
                </div>
            </div>
            <!-- Phần đánh giá và bình luận -->
            <div class="review-section">
                <h4>Đánh giá sản phẩm</h4>
                <div class="star-rating" data-icecream-id="@Model.IceCream.IceCreamId">
                    <span class="star" data-value="5">★</span>
                    <span class="star" data-value="4">★</span>
                    <span class="star" data-value="3">★</span>
                    <span class="star" data-value="2">★</span>
                    <span class="star" data-value="1">★</span>
                </div>
                <textarea class="form-control mt-2 review-comment" placeholder="Viết bình luận..." rows="3" data-icecream-id="@Model.IceCream.IceCreamId"></textarea>
                <button class="btn btn-add-cart mt-2" onclick="submitReview(@Model.IceCream.IceCreamId)">Gửi đánh giá</button>
                <!-- Danh sách bình luận -->
                <div class="review-list" id="reviewList"></div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger" role="alert">
            Không tìm thấy sản phẩm.
        </div>
    }
</div>

@section Scripts {
    <script>
        const userId = @Model.CurrentUserId;
        const token = '@HttpContext.Session.GetString("JWToken")';
        const iceCreamId = @Model.IceCream?.IceCreamId ?? 0;

        // Lấy danh sách đánh giá khi trang tải
        async function fetchReviews() {
            try {
                const response = await fetch(`https://localhost:7283/api/ReviewApi?iceCreamId=${iceCreamId}`);
                if (!response.ok) {
                    throw new Error("Không thể lấy danh sách đánh giá.");
                }
                const reviews = await response.json();
                renderReviews(reviews);
            } catch (error) {
                console.error("Lỗi khi lấy đánh giá:", error);
                document.getElementById("reviewList").innerHTML = "<p>Không thể tải đánh giá.</p>";
            }
        }

        // Hiển thị danh sách đánh giá
        function renderReviews(reviews) {
            const reviewList = document.getElementById("reviewList");
            reviewList.innerHTML = "";
            if (reviews.length === 0) {
                reviewList.innerHTML = "<p>Chưa có đánh giá nào.</p>";
                return;
            }
            reviews.forEach(review => {
                const stars = '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating);
                reviewList.innerHTML += `
                            <div class="review-item">
                                <span class="review-user">${review.fullName}</span>:
                                <span class="review-stars">${stars}</span>
                                <p>${review.comment || 'Không có bình luận'}</p>
                            </div>`;
            });
        }

        // Gắn sự kiện cho sao
        function attachStarRatingEvents() {
            document.querySelectorAll('.star').forEach(star => {
                star.addEventListener('click', function () {
                    const rating = parseInt(this.getAttribute('data-value')); // Lấy giá trị sao
                    const starContainer = this.parentElement;
                    const stars = starContainer.querySelectorAll('.star');

                    // Xóa class 'selected' khỏi tất cả các sao
                    stars.forEach(s => s.classList.remove('selected'));

                    // Thêm class 'selected' cho các sao từ rating trở xuống
                    stars.forEach(s => {
                        if (parseInt(s.getAttribute('data-value')) >= rating) {
                            s.classList.add('selected');
                        }
                    });

                    // Lưu giá trị rating vào data attribute của container
                    starContainer.setAttribute('data-rating', rating);
                });
            });
        }

        // Gửi đánh giá
        async function submitReview(iceCreamId) {
            if (!userId) {
                alert("Vui lòng đăng nhập để gửi đánh giá!");
                window.location.href = "/Auth/Login";
                return;
            }

            const ratingElement = document.querySelector(`.star-rating[data-icecream-id="${iceCreamId}"]`);
            const commentElement = document.querySelector(`.review-comment[data-icecream-id="${iceCreamId}"]`);
            const rating = ratingElement.getAttribute('data-rating') || 0;
            const comment = commentElement.value.trim();

            if (!rating || rating == 0) {
                alert("Vui lòng chọn số sao để đánh giá!");
                return;
            }

            const review = {
                UserId: userId,
                IceCreamId: iceCreamId,
                Rating: parseInt(rating),
                Comment: comment,
                CreatedAt: new Date().toISOString()
            };

            try {
                const response = await fetch("https://localhost:7283/api/ReviewApi", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify(review)
                });

                if (response.ok) {
                    const result = await response.json();
                    alert("Đánh giá của bạn đã được gửi thành công!");
                    ratingElement.setAttribute('data-rating', 0);
                    ratingElement.querySelectorAll('.star').forEach(s => s.classList.remove('selected'));
                    commentElement.value = "";
                    fetchReviews(); // Cập nhật danh sách đánh giá
                } else {
                    const error = await response.json();
                    alert(`Không thể gửi đánh giá: ${error.message || 'Lỗi không xác định'}`);
                }
            } catch (error) {
                console.error("Lỗi khi gửi đánh giá:", error);
                alert("Đã xảy ra lỗi khi gửi đánh giá: " + error.message);
            }
        }

        async function addToCart(iceCreamId) {
            if (!userId) {
                alert("Vui lòng đăng nhập để thêm vào giỏ hàng!");
                window.location.href = "/Auth/Login";
                return;
            }

            const cartItem = {
                UserId: userId,
                IceCreamId: iceCreamId,
                Quantity: 1
            };

            try {
                const response = await fetch("https://localhost:7283/api/CartApi", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify(cartItem)
                });

                if (response.ok) {
                    const result = await response.json();
                    alert(`Đã thêm ${result.iceCream?.name || 'kem'} vào giỏ hàng!`);
                } else {
                    const error = await response.json();
                    alert(`Không thể thêm vào giỏ hàng: ${error.message || 'Lỗi không xác định'} (Status: ${response.status})`);
                }
            } catch (error) {
                console.error("Lỗi khi thêm vào giỏ hàng:", error);
                alert("Đã xảy ra lỗi khi thêm vào giỏ hàng: " + error.message);
            }
        }

        async function checkoutIceCream(iceCreamId) {
            if (!userId) {
                alert("Vui lòng đăng nhập để thanh toán!");
                window.location.href = "/Auth/Login";
                return;
            }

            const cartItem = {
                UserId: userId,
                IceCreamId: iceCreamId,
                Quantity: 1
            };

            try {
                const response = await fetch("https://localhost:7283/api/CartApi", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify(cartItem)
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`Không thể thêm vào giỏ hàng: ${errorText}`);
                }

                window.location.href = "/User/Checkout";
            } catch (error) {
                console.error("Lỗi khi thêm vào giỏ hàng trước khi thanh toán:", error);
                alert("Đã xảy ra lỗi: " + error.message);
            }
        }

        // Gọi khi trang tải
        if (iceCreamId) {
            fetchReviews();
            attachStarRatingEvents();
        }
    </script>
}