@page
@model IcreamShopCilent.Pages.User.IndexModel
@{
    ViewData["Title"] = "Cửa hàng kem";
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* Style cho trang Home */
        .home-container {
            padding: 20px;
            background: linear-gradient(135deg, #fff3e0, #ffe6f2, #e6f7ff);
            min-height: 100vh;
        }

        .search-filter {
            margin-bottom: 20px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .form-control-search {
            border-radius: 10px;
            border: 2px solid #ffd6e8;
            transition: border-color 0.3s;
        }

            .form-control-search:focus {
                border-color: #ff6f91;
                box-shadow: none;
            }

        .btn.icecream {
            background: linear-gradient(45deg, #ff6f91, #ffcc70);
            border: none;
            border-radius: 10px;
            padding: 8px 15px;
            color: white;
            font-weight: bold;
            transition: transform 0.2s;
        }

            .btn.icecream:hover {
                transform: scale(1.05);
            }

        .icecream-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s;
            overflow: hidden;
            background: white;
            margin-bottom: 20px;
        }

            .icecream-card:hover {
                transform: translateY(-5px);
            }

        .card-img-top {
            height: 200px;
            object-fit: cover;
            border-radius: 15px 15px 0 0;
        }

        .card-title {
            font-family: 'Comic Sans MS', cursive, sans-serif;
            color: #ff6f91;
            font-size: 1.2rem;
        }

        .card-text {
            color: #555;
        }

        .btn-add-cart {
            background: linear-gradient(45deg, #ff6f91, #ffcc70);
            border: none;
            border-radius: 10px;
            padding: 5px 10px;
            color: white;
            font-weight: bold;
            transition: transform 0.2s;
        }

            .btn-add-cart:hover {
                transform: scale(1.05);
            }

        .icecream-emoji {
            font-size: 1.5em;
            margin: 0 5px;
        }
    </style>
}
<!-- Hộp Trò Chuyện AI -->
<div class="chat-container">
    <div class="chat-header" onclick="toggleChat()">
        <span>Trò chuyện với Trợ lý AI 🍦</span>
        <span class="chat-toggle">✖</span>
    </div>
    <div class="chat-body" id="chatBody">
        <div class="chat-messages" id="chatMessages"></div>
        <div class="chat-input">
            <input type="text" id="chatInput" placeholder="Hỏi về kem..." />
            <button class="btn icecream" onclick="sendMessage()">Gửi</button>
        </div>
    </div>
</div>

<div class="home-container">
    <div class="search-filter">
        <div class="input-group w-50">
            <input id="searchInput" type="text" class="form-control form-control-search" placeholder="Tìm kiếm kem..." aria-label="Tìm kiếm" />
            <button class="btn btn icecream" type="button" onclick="searchIceCream()">Tìm kiếm <span class="icecream-emoji">🔍</span></button>
        </div>
    </div>

    <div id="iceCreamList" class="row row-cols-1 row-cols-md-3 g-4"></div>

    <!-- Phần phân trang -->
    <div class="pagination" id="pagination">
        <button id="prevPage" onclick="changePage(currentPage - 1)">Previous</button>
        <span id="pageInfo"></span>
        <button id="nextPage" onclick="changePage(currentPage + 1)">Next</button>
    </div>
</div>

@section Scripts {
    <script>
        // Giả sử UserId được truyền từ server (thay thế bằng logic xác thực thực tế)
        const userId = @Model.CurrentUserId; // Cần triển khai trong IndexModel để lấy UserId
        const pageSize = 6; // Số lượng kem trên mỗi trang
        let currentPage = 1; // Trang hiện tại
        let totalPages = 1; // Tổng số trang
        let allIceCreams = []; // Lưu toàn bộ dữ liệu từ API

        async function fetchIceCreams(query = "") {
            let baseUrl = "https://localhost:7283";
            let url = query ? `${baseUrl}/api/IceCreamApi/search?name=${query}` : `${baseUrl}/api/IceCreamApi`;

            try {
                let response = await fetch(url);
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`Không thể lấy danh sách kem. Mã trạng thái: ${response.status}. Phản hồi: ${errorText}`);
                }
                allIceCreams = await response.json(); // Lưu toàn bộ dữ liệu vào biến toàn cục

                // Tính toán phân trang
                totalPages = Math.ceil(allIceCreams.length / pageSize);
                currentPage = 1; // Reset về trang 1 khi lấy dữ liệu mới

                // Hiển thị dữ liệu cho trang hiện tại
                renderIceCreamsForPage(currentPage);

                // Cập nhật giao diện phân trang
                updatePagination();
            } catch (error) {
                console.error("Lỗi khi lấy danh sách kem:", error);
                alert("Đã xảy ra lỗi khi tải danh sách kem: " + error.message);
            }
        }

        function renderIceCreamsForPage(page) {
            let startIndex = (page - 1) * pageSize;
            let endIndex = startIndex + pageSize;
            let pageData = allIceCreams.slice(startIndex, endIndex); // Lấy dữ liệu cho trang hiện tại

            let container = document.getElementById("iceCreamList");
            container.innerHTML = "";
            pageData.forEach(item => {
                container.innerHTML += `
                    <div class="col">
                        <div class="card icecream-card" onclick="window.location.href='/User/IceCreamDetail/${item.iceCreamId}'">
                            <img src="${item.imageUrl}" class="card-img-top" alt="${item.name}">
                            <div class="card-body">
                                <h5 class="card-title">${item.name}</h5>
                                <p class="card-text">$${item.price.toFixed(2)}</p>
                                <button class="btn btn-add-cart" onclick="event.stopPropagation(); addToCart(${item.iceCreamId})">Thêm vào giỏ hàng <span class="icecream-emoji">🛒</span></button>
                            </div>
                        </div>
                    </div>`;
            });
        }

        function updatePagination() {
            document.getElementById("pageInfo").textContent = `Page ${currentPage} of ${totalPages}`;
            document.getElementById("prevPage").disabled = currentPage === 1;
            document.getElementById("nextPage").disabled = currentPage === totalPages;
        }

        function changePage(page) {
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderIceCreamsForPage(currentPage);
            updatePagination();
        }

        function searchIceCream() {
            currentPage = 1; // Reset về trang 1 khi tìm kiếm
            let query = document.getElementById("searchInput").value;
            fetchIceCreams(query);
        }

        const token = '@HttpContext.Session.GetString("JWToken")'; // Lấy token từ session

        async function addToCart(iceCreamId) {
            if (!userId) {
                alert("Vui lòng đăng nhập để thêm vào giỏ hàng!");
                window.location.href = "/Auth/Login";
                return;
            }

            console.log("IceCreamId gửi lên:", iceCreamId); // Log IceCreamId

            const cartItem = {
                UserId: userId,
                IceCreamId: iceCreamId,
                Quantity: 1
            };

            try {
                const response = await fetch("https://localhost:7283/api/CartApi", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify(cartItem)
                });

                console.log("Mã trạng thái HTTP:", response.status);
                const contentType = response.headers.get("content-type");
                console.log("Content-Type:", contentType);

                if (response.ok) {
                    const result = await response.json();
                    alert(`Đã thêm ${result.iceCream?.name || 'kem'} vào giỏ hàng!`);
                } else {
                    if (contentType && contentType.includes("application/json")) {
                        const error = await response.json();
                        console.error("Lỗi từ API:", error);
                        alert(`Không thể thêm vào giỏ hàng: ${error.message || 'Lỗi không xác định'} (Status: ${response.status})`);
                    } else {
                        const errorText = await response.text();
                        console.error("Phản hồi không phải JSON:", errorText);
                        alert(`Không thể thêm vào giỏ hàng: ${errorText} (Status: ${response.status})`);
                    }
                }
            } catch (error) {
                console.error("Lỗi khi thêm vào giỏ hàng:", error);
                alert("Đã xảy ra lỗi khi thêm vào giỏ hàng: " + error.message);
            }
        }

        // Tự động lấy danh sách kem khi trang được tải
        fetchIceCreams();

        function toggleChat() {
            const chatBody = document.getElementById('chatBody');
            const toggleBtn = document.querySelector('.chat-toggle');
            if (chatBody.style.display === 'block') {
                chatBody.style.display = 'none';
                toggleBtn.textContent = '✖';
            } else {
                chatBody.style.display = 'block';
                toggleBtn.textContent = '▼';
            }
        }

        async function sendMessage() {
            const input = document.getElementById('chatInput');
            const messages = document.getElementById('chatMessages');
            const message = input.value.trim();

            if (!message) return;

            // Thêm tin nhắn của người dùng
            messages.innerHTML += `
                <div class="chat-message user-message">${message}</div>
            `;

            input.value = '';
            messages.scrollTop = messages.scrollHeight;

            try {
                // Giả lập phản hồi AI (thay bằng gọi API thực tế)
                const aiResponse = await getAIResponse(message);
                messages.innerHTML += `
                    <div class="chat-message ai-message">${aiResponse}</div>
                `;
                messages.scrollTop = messages.scrollHeight;
            } catch (error) {
                console.error('Lỗi trò chuyện:', error);
                messages.innerHTML += `
                    <div class="chat-message ai-message">Xin lỗi, đã xảy ra lỗi!</div>
                `;
            }
        }

        // Phản hồi AI giả lập (thay bằng tích hợp API thực tế)
        async function getAIResponse(message) {
            try {
                const response = await fetch('https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=AIzaSyDFenPyE3_qh5NTSwssqEGXYLlHk4burQ0', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: message }] }]
                    })
                });
                const data = await response.json();
                return data.candidates[0].content.parts[0].text || 'Tôi không thể trả lời ngay bây giờ!';
            } catch (error) {
                throw new Error('Không thể kết nối với Gemini AI');
            }
        }

        // Xử lý phím Enter
        document.getElementById('chatInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
    </script>
}