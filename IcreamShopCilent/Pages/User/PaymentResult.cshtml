@page
@model IcreamShopCilent.Pages.User.PaymentResultModel
@{
    ViewData["Title"] = "Kết quả thanh toán";
    Layout = "_Layout";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Kết quả thanh toán</h2>
    @if (TempData["PaymentMessage"] != null)
    {
        <div class="alert alert-info">@TempData["PaymentMessage"]</div>
    }
    <div class="text-center">
        <a href="/User/Cart" class="btn btn-primary">Quay lại giỏ hàng</a>
    </div>
</div>